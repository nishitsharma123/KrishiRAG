# KrishiRAG Backend Configuration

PROJECT_NAME=KrishiRAG
VERSION=1.0.0
API_PREFIX=/api
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database
DATABASE_URL=sqlite:///./data/krishirag.db

# Vector Database (Qdrant)
QDRANT_STORAGE_PATH=./data/qdrant_db
QDRANT_COLLECTION_NAME=icar_agricultural_knowledge

# Embeddings & Retrieval Settings
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_BATCH_SIZE=8
TOP_K_DENSE=10
TOP_K_SPARSE=10
FINAL_CONTEXT_CHUNKS=5

# LLM (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_CONTEXT_WINDOW=4096
OLLAMA_NUM_THREADS=4
